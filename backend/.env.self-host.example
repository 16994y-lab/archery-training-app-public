# Copy to an ignored local file and replace placeholders. Startup will check the runtime grants.
AUTH_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql+psycopg://gongxingji_runtime:replace-me@127.0.0.1:5432/gongxingji
# Keep the owner connection out of this runtime file. Export MIGRATION_DATABASE_URL separately for migration.
# Use sslmode=verify-full and configure the server's trust root for remote PostgreSQL.
# Omit CORS_ORIGINS when the built web site and API are served on the same origin.
# CORS_ORIGINS=http://127.0.0.1:5173
# SELF_HOST_WEB_ROOT=../frontend/dist
